@import "../../app.wxss";

.modes { display: flex; background: #f1f4fa; border-radius: 999rpx; padding: 8rpx; margin-bottom: 24rpx; }
.mode { flex: 1; text-align: center; font-size: 26rpx; color: #5b6577; padding: 14rpx 0; border-radius: 999rpx; }
.mode.on { background: #fff; color: #2f6df6; font-weight: 600; box-shadow: 0 4rpx 14rpx rgba(31, 45, 70, 0.10); }
.mode.dim { opacity: 0.4; }

.drop { height: 420rpx; border: 3rpx dashed #cfd9ea; border-radius: 24rpx; background: #fafbff;
        display: flex; align-items: center; justify-content: center; margin-bottom: 22rpx; overflow: hidden; }
.preview { width: 100%; height: 100%; }
.hint { text-align: center; }
.hint-main { display: block; font-size: 28rpx; color: #2f6df6; margin-bottom: 10rpx; }
.hint-sub { display: block; font-size: 24rpx; color: #8a94a6; }

.portion { display: flex; align-items: center; margin-top: 24rpx; }
.lab { font-size: 24rpx; color: #6b7686; margin-right: 16rpx; }
.seg { display: flex; border: 2rpx solid #e6eaf2; border-radius: 999rpx; overflow: hidden; background: #f7f9fe; }
.seg-item { padding: 10rpx 26rpx; font-size: 24rpx; color: #5b6577; }
.seg-item.on { background: linear-gradient(135deg, #2f6df6, #7a5af8); color: #fff; font-weight: 600; }

.weight { display: flex; align-items: center; margin-top: 20rpx; }
.winput { width: 150rpx; padding: 10rpx 16rpx; border: 2rpx solid #e6eaf2; border-radius: 14rpx;
          background: #fbfcff; text-align: right; font-size: 26rpx; }
.winput.small { width: 130rpx; }
.unit { font-size: 24rpx; color: #5b6577; margin: 0 12rpx; }
.tip { font-size: 22rpx; color: #98a2b3; }

.warn { margin: 4rpx 0 20rpx; background: #fff8ee; border: 2rpx solid #f3c98b; border-radius: 16rpx;
        padding: 16rpx 18rpx; font-size: 24rpx; color: #7c4a10; line-height: 1.7; }

.item { border: 2rpx solid #e6eaf2; border-radius: 20rpx; padding: 22rpx; margin-bottom: 18rpx; }
.item.top { border-color: #c8dafd; background: linear-gradient(180deg, #f7faff, #fff); }
.rank { font-size: 22rpx; color: #8a94a6; margin-bottom: 6rpx; }
.dish { display: flex; align-items: baseline; }
.zh { font-size: 36rpx; font-weight: 700; margin-right: 12rpx; }
.en { font-size: 22rpx; color: #8a94a6; }
.kcal { font-size: 24rpx; color: #6b7686; margin-top: 10rpx; }
.kcal-v { color: #e0562a; font-size: 34rpx; font-weight: 700; }
.kcal-sub { font-size: 22rpx; color: #98a2b3; }
.bar { height: 14rpx; border-radius: 99rpx; background: #eef1f7; overflow: hidden; margin-top: 16rpx; }
.bar-in { height: 100%; border-radius: 99rpx; background: linear-gradient(90deg, #2f6df6, #7a5af8); }
.prob { font-size: 22rpx; color: #8a94a6; margin-top: 8rpx; text-align: right; }

.part { border: 2rpx solid #e6eaf2; border-radius: 20rpx; padding: 20rpx; margin-bottom: 16rpx; }
.part-kcal { font-size: 28rpx; color: #1b2430; font-weight: 600; margin-top: 8rpx; }
.part-ctl { display: flex; align-items: center; margin-top: 14rpx; }
.seg.small .seg-item { padding: 6rpx 18rpx; font-size: 22rpx; }

.total { border: 2rpx solid #c8dafd; border-radius: 22rpx; padding: 22rpx;
         background: linear-gradient(135deg, #f5f8ff, #fff); }
.total-l { font-size: 24rpx; color: #6b7686; }
.total-v { font-size: 46rpx; font-weight: 800; color: #e0562a; margin-top: 4rpx; }
.total-m { font-size: 22rpx; color: #8a94a6; margin-top: 4rpx; }

.note { font-size: 22rpx; color: #8a94a6; line-height: 1.7; margin-top: 18rpx;
        border-top: 2rpx dashed #e6eaf2; padding-top: 16rpx; }
.err { margin-top: 18rpx; font-size: 24rpx; color: #b42318; background: #fef3f2;
       border: 2rpx solid #fecdca; border-radius: 16rpx; padding: 16rpx; }
.foot { font-size: 22rpx; color: #98a2b3; text-align: center; padding: 8rpx 24rpx 30rpx; line-height: 1.7; }
